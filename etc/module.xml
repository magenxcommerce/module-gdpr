<?xml version="1.0"?>
<!--
  Cookie registry, consent logging and data-subject request tracking: data,
  admin UI and cron. No Luma frontend is added (no view/frontend, no
  frontend controllers/layout) - the storefront is Next.js. view/adminhtml
  is used for the merchant-facing cookie registry and request queue, which
  have no storefront equivalent.

  The GraphQL surface lives in the companion Magenx_GdprGraphQl module (the
  usual Magenx <Name> / <Name>GraphQl split), so this module has no
  Magento_GraphQl dependency of its own.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Module/etc/module.xsd">
    <module name="Magenx_Gdpr">
        <sequence>
            <module name="Magento_Backend"/>
            <module name="Magento_Config"/>
            <module name="Magento_Cron"/>
            <module name="Magento_Customer"/>
            <module name="Magento_Integration"/>
            <module name="Magento_Newsletter"/>
            <module name="Magento_Sales"/>
            <module name="Magento_Ui"/>
        </sequence>
    </module>
</config>
