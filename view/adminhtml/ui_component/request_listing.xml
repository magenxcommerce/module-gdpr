<?xml version="1.0" encoding="UTF-8"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_components.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">request_listing.request_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <spinner>request_columns</spinner>
        <deps>
            <dep>request_listing.request_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="request_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">request_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>Magenx_Gdpr::requests</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider" name="request_listing_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>request_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="request_columns">
        <column name="request_id">
            <settings>
                <filter>text</filter>
                <label translate="true">ID</label>
                <sorting>desc</sorting>
            </settings>
        </column>
        <column name="requested_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Requested</label>
            </settings>
        </column>
        <column name="customer_id">
            <settings>
                <filter>text</filter>
                <label translate="true">Customer ID</label>
            </settings>
        </column>
        <column name="type">
            <settings>
                <filter>select</filter>
                <label translate="true">Type</label>
            </settings>
        </column>
        <column name="status">
            <settings>
                <filter>select</filter>
                <label translate="true">Status</label>
            </settings>
        </column>
        <column name="resolved_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Resolved</label>
            </settings>
        </column>
        <column name="customer_note">
            <settings>
                <filter>text</filter>
                <label translate="true">Customer Note</label>
                <visible>false</visible>
            </settings>
        </column>
        <column name="admin_note">
            <settings>
                <filter>text</filter>
                <label translate="true">Admin Note</label>
                <visible>false</visible>
            </settings>
        </column>
        <actionsColumn name="actions" class="Magenx\Gdpr\Ui\Component\Listing\Column\RequestActions">
            <settings>
                <indexField>request_id</indexField>
            </settings>
        </actionsColumn>
    </columns>
</listing>
