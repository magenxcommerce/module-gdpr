<?xml version="1.0" encoding="UTF-8"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_components.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">cookie_listing.cookie_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <spinner>cookie_columns</spinner>
        <deps>
            <dep>cookie_listing.cookie_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="cookie_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">cookie_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>Magenx_Gdpr::cookies</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider" name="cookie_listing_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>cookie_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <paging name="listing_paging"/>
        <buttons>
            <button name="add">
                <url path="*/*/new"/>
                <class>primary</class>
                <label translate="true">Add Cookie</label>
            </button>
        </buttons>
    </listingToolbar>
    <columns name="cookie_columns">
        <column name="cookie_id">
            <settings>
                <filter>text</filter>
                <label translate="true">ID</label>
                <sorting>asc</sorting>
            </settings>
        </column>
        <column name="name">
            <settings>
                <filter>text</filter>
                <label translate="true">Name</label>
            </settings>
        </column>
        <column name="group_id">
            <settings>
                <filter>text</filter>
                <label translate="true">Group ID</label>
            </settings>
        </column>
        <column name="source">
            <settings>
                <filter>text</filter>
                <label translate="true">Source</label>
            </settings>
        </column>
        <column name="duration_label">
            <settings>
                <filter>text</filter>
                <label translate="true">Duration</label>
            </settings>
        </column>
        <column name="is_active" component="Magento_Ui/js/grid/columns/select">
            <argument name="data" xsi:type="array">
                <item name="options" xsi:type="array">
                    <item name="0" xsi:type="array">
                        <item name="value" xsi:type="number">0</item>
                        <item name="label" xsi:type="string" translate="true">No</item>
                    </item>
                    <item name="1" xsi:type="array">
                        <item name="value" xsi:type="number">1</item>
                        <item name="label" xsi:type="string" translate="true">Yes</item>
                    </item>
                </item>
            </argument>
            <settings>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Active</label>
            </settings>
        </column>
        <actionsColumn name="actions" class="Magenx\Gdpr\Ui\Component\Listing\Column\EntityActions">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="indexField" xsi:type="string">cookie_id</item>
                    <item name="editUrlPath" xsi:type="string">magenx_gdpr/cookie/edit</item>
                    <item name="deleteUrlPath" xsi:type="string">magenx_gdpr/cookie/delete</item>
                </item>
            </argument>
            <settings>
                <indexField>cookie_id</indexField>
            </settings>
        </actionsColumn>
    </columns>
</listing>
